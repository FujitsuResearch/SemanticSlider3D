# Copy this file to `.env` and edit the values for your machine.
# Any variable left commented-out falls back to its default (see config.py).
# Shell `export SS3D_FOO=...` overrides values here.

# User session logs, GLBs, renders. Grows fast — point at a big disk.
# Default: <ml_servers>/logs
# SS3D_DATA_DIR=/mnt/big-disk/ss3d_logs

# SAM3D model checkpoints (several GB). Put on fast, roomy storage.
# Default: sam3d_ckpts
# SS3D_SAM3D_CKPTS=/mnt/big-disk/sam3d_ckpts

# TRELLIS repo clone. Default: <repo-root>/TRELLIS (sibling of ml_servers/)
# SS3D_TRELLIS_ROOT=/opt/TRELLIS

# sam-3d-objects repo clone. Default: <repo-root>/sam-3d-objects
# SS3D_SAM3D_ROOT=/opt/sam-3d-objects

# SemanticSlider3D's own utilities (slider mapping, view rendering, prompt gen).
# Default: <repo-root>/ss3d_utils (sibling of ml_servers/, NOT inside TRELLIS/)
# SS3D_UTILS_ROOT=/opt/ss3d_utils

# GPU id(s) for app.py (SAM2 + SAM3D). Sets CUDA_VISIBLE_DEVICES before torch
# imports, so the chosen physical GPU becomes cuda:0. Accepts "0", "1", "0,1".
# Default: unset (all visible GPUs, torch picks cuda:0).
# SS3D_APP_GPU=1

# --- trellis_server.py GPU layout ---

# GPU for the main TRELLIS text-to-3D pipeline. Override per run with --gpu.
# Default: 0
# SS3D_TRELLIS_PIPELINE_GPU=0

# Worker pools for concurrent slider building. Format:
#   "<pool>,<pool>,..."  where each <pool> is "+"-separated GPU ids.
#   "2,3"       → two pools: GPUs [2] and [3]  (default)
#   "2+3,4+5"   → two pools with two GPUs each
#   "0"         → single pool on GPU 0 (one slider at a time)
# Pipeline and pool GPUs should typically NOT overlap.
# SS3D_TRELLIS_POOL_GPUS=2,3

# Workers per GPU within each pool. Default: 4
# SS3D_TRELLIS_WORKERS_PER_GPU=4
